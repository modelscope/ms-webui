{
  "name": "@modelscope/ms-webui",
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for ms-swift: training / inference / deploy workbench with bundled model skills",
  "bin": {
    "ms-webui": "scripts/start.mjs"
  },
  "files": [
    "src",
    "public",
    "scripts",
    "challenger-templates",
    "index.html",
    "vite.config.ts",
    "components.json",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-skills.mjs && vite build",
    "preview": "vite preview",
    "fetch:skills": "node scripts/fetch-skills.mjs",
    "check:swift": "node scripts/check-swift.mjs",
    "prepack": "node scripts/fetch-skills.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "gpt-tokenizer": "^4.1.0",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelscope/ms-webui.git"
  },
  "license": "Apache-2.0"
}
